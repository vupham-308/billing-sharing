# ==============================================================================
# BILLING SHARING BACKEND - ENVIRONMENT VARIABLES (.env)
# Đặt file này tại: /home/ubuntu/app/billing-sharing/.env
# ==============================================================================

# Cấu hình kết nối SQL Server Database
DB_HOST=localhost
DB_PORT=1433
DB_NAME=billing_sharing
DB_USERNAME=sa
DB_PASSWORD=YourStrongPasswordHere!

# Cấu hình Pool kết nối (mặc định 5 cho VPS ít RAM/CPU)
DB_MAX_POOL_SIZE=5

# Cấu hình dịch vụ gửi Email qua Brevo (REST API qua cổng 443 HTTPS)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@kaidz.xyz
BREVO_SENDER_NAME=Billing Sharing

# Cấu hình JWT Secret Key (Tùy chọn ghi đè để bảo mật)
# JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Cấu hình in log SQL (mặc định false để tiết kiệm CPU và đĩa)
SHOW_SQL=false
